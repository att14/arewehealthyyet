---
import type { Facet } from '../lib/view';

interface Group {
  id: string;
  label: string;
  hint?: string;
  options: Facet[];
}
interface Props { groups: Group[] }
const { groups } = Astro.props;
---

<form class="filters" aria-label="Filter what you see">
  <div class="filters__head">
    <p class="filters__title">Narrow it down</p>
    <button type="button" class="clear" hidden>Clear all</button>
  </div>

  {groups.filter((g) => g.options.length > 1).map((group) => (
    <fieldset class="group">
      <legend>{group.label}{group.hint && <span class="hint"> {group.hint}</span>}</legend>
      <div class="chips">
        {group.options.map((option) => (
          <label class="chip">
            <input type="checkbox" name={group.id} value={option.key} />
            <span>{option.label}<b>{option.count}</b></span>
          </label>
        ))}
      </div>
    </fieldset>
  ))}

  <p class="result" role="status" aria-live="polite"></p>
</form>

<style>
  .filters {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1rem 1.1rem 0.85rem;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .filters__head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .filters__title { font-weight: 700; font-size: 1rem; }

  .clear {
    background: none;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.3rem 0.8rem;
    font: inherit;
    font-size: 0.85rem;
    color: var(--ink-secondary);
    cursor: pointer;
    min-height: 34px;
  }
  .clear:hover { background: var(--surface-sunken); }

  .group { border: 0; margin: 0; padding: 0; }
  legend {
    padding: 0;
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 700;
    color: var(--ink-muted);
    margin-bottom: 0.4rem;
  }
  .hint { text-transform: none; letter-spacing: 0; font-weight: 400; }

  .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }

  .chip input { position: absolute; opacity: 0; width: 0; height: 0; }
  .chip span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    /* Thumb-sized: this bar is used on a phone more than a desktop. */
    min-height: 40px;
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink-secondary);
    font-size: 0.9rem;
    cursor: pointer;
    user-select: none;
  }
  .chip span b {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--ink-muted);
    background: var(--surface-sunken);
    border-radius: 999px;
    padding: 0.05rem 0.4rem;
    font-variant-numeric: tabular-nums;
  }
  .chip input:checked + span {
    background: var(--series-1);
    border-color: var(--series-1);
    color: #fff;
  }
  .chip input:checked + span b { background: rgba(255, 255, 255, 0.25); color: #fff; }
  .chip input:focus-visible + span { outline: 2px solid var(--series-1); outline-offset: 2px; }

  .result { font-size: 0.88rem; color: var(--ink-secondary); }
  .result:empty { display: none; }
</style>
