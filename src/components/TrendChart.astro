---
import type { Trend } from '../lib/types';
import { num } from '../lib/view';

interface Props { trend: Trend }
const { trend } = Astro.props;

const W = 300;
const H = 78;
const PAD = 4;

const all = [...trend.currentYear, ...trend.previousYear];
const max = Math.max(1, ...all.map((p) => p.cases));
const x = (week: number) => PAD + ((week - 1) / 51) * (W - PAD * 2);
const y = (cases: number) => H - PAD - (cases / max) * (H - PAD * 2);
const path = (points: typeof trend.currentYear) =>
  points.map((p, i) => `${i === 0 ? 'M' : 'L'}${x(p.week).toFixed(1)},${y(p.cases).toFixed(1)}`).join(' ');

const last = trend.currentYear.at(-1);
const change =
  trend.previousYearTotalToDate > 0
    ? Math.round(((trend.currentYearTotal - trend.previousYearTotalToDate) / trend.previousYearTotalToDate) * 100)
    : null;

const caption =
  change === null
    ? 'No comparable count for last year.'
    : change > 10
      ? `Running ${change}% higher than this time last year.`
      : change < -10
        ? `Running ${Math.abs(change)}% lower than this time last year.`
        : 'About the same as this time last year.';

const seriesData = JSON.stringify({
  name: trend.displayName,
  max,
  current: trend.currentYear,
  previous: trend.previousYear,
});
---

<figure class="trend" data-trend={seriesData}>
  <figcaption>
    <h3>{trend.displayName}</h3>
    <p class="total"><b>{num(trend.currentYearTotal)}</b> cases reported this year</p>
    <p class="change">{caption}</p>
  </figcaption>

  <div class="plot">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Weekly ${trend.displayName} cases this year compared with last year. ${caption}`} preserveAspectRatio="none">
      <line x1={PAD} y1={H - PAD} x2={W - PAD} y2={H - PAD} class="axis" />
      <path d={path(trend.previousYear)} class="line line--prev" />
      <path d={path(trend.currentYear)} class="line line--now" />
      {last && <circle cx={x(last.week)} cy={y(last.cases)} r="3.5" class="marker" />}
      <line class="crosshair" x1="0" y1={PAD} x2="0" y2={H - PAD} />
    </svg>
    <div class="tooltip" hidden></div>
  </div>

  <details class="numbers">
    <summary>See the weekly numbers</summary>
    <div class="tablewrap">
      <table>
        <thead><tr><th>Week</th><th>This year</th><th>Last year</th></tr></thead>
        <tbody>
          {trend.currentYear.map((p) => (
            <tr>
              <td>{p.week}</td>
              <td>{num(p.cases)}</td>
              <td>{num(trend.previousYear.find((q) => q.week === p.week)?.cases ?? null)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</figure>

<style>
  .trend {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.9rem 1rem;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  figcaption { display: flex; flex-direction: column; gap: 0.1rem; }
  h3 { font-size: 1.05rem; }
  .total { font-size: 0.9rem; color: var(--ink-secondary); }
  .total b { font-size: 1.25rem; color: var(--ink); font-variant-numeric: tabular-nums; }
  .change { font-size: 0.85rem; color: var(--ink-secondary); }

  .plot { position: relative; }
  svg { width: 100%; height: 78px; display: block; overflow: visible; }

  .axis { stroke: var(--baseline); stroke-width: 1; }
  .line { fill: none; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  /* Last year is a reference, not a peer series: neutral and dashed so this year reads first. */
  .line--prev { stroke: var(--series-reference); stroke-dasharray: 3 3; }
  .line--now { stroke: var(--series-1); }
  .marker { fill: var(--series-1); stroke: var(--surface); stroke-width: 2; }
  .crosshair { stroke: var(--baseline); stroke-width: 1; visibility: hidden; }
  .crosshair.is-on { visibility: visible; }

  .tooltip {
    position: absolute;
    top: 0;
    transform: translate(-50%, -105%);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    box-shadow: var(--shadow);
    padding: 0.35rem 0.55rem;
    font-size: 0.78rem;
    line-height: 1.35;
    white-space: nowrap;
    pointer-events: none;
    z-index: 2;
  }
  .tooltip[hidden] { display: none; }
  .tooltip b { font-variant-numeric: tabular-nums; }

  .numbers summary {
    font-size: 0.83rem;
    color: var(--ink-secondary);
    cursor: pointer;
    padding: 0.2rem 0;
  }
  .numbers .tablewrap { max-height: 220px; overflow: auto; margin-top: 0.4rem; }
  .numbers table { width: 100%; border-collapse: collapse; font-size: 0.82rem; }
  .numbers th, .numbers td {
    text-align: left;
    padding: 0.2rem 0.5rem 0.2rem 0;
    border-bottom: 1px solid var(--rule);
    font-variant-numeric: tabular-nums;
  }
</style>
